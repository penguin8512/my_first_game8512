    def _draw_exit(self):
        W, H = self.W, self.H
        self.screen.fill(DARK_BG)
        fn = self.fonts['normal']
        fb = self.fonts['big']

        # dim overlay
        ov = pygame.Surface((W, H), pygame.SRCALPHA)
        ov.fill((0, 0, 0, 160))
        self.screen.blit(ov, (0, 0))

        # dialog box
        box = pygame.Rect(W//2 - 250, H//2 - 130, 500, 260)
        draw_rounded_rect(self.screen, PANEL_BG, box, 20)
        pygame.draw.rect(self.screen, ACCENT, box, 2, border_radius=20)

        # sad robot
        bob = math.sin(self.float_t) * 4
        self._draw_robot(W//2, int(H//2 - 80 + bob), scale=0.75, expression="normal")

        title = fb.render("確定要離開嗎？", True, WHITE)
        self.screen.blit(title, title.get_rect(centerx=W//2, y=H//2 - 20))
        sub = fn.render("Botty 會很想念你的…", True, TEXT_GRAY)
        self.screen.blit(sub, sub.get_rect(centerx=W//2, y=H//2 + 22))

        self.btn_quit_yes.draw(self.screen, fn)
        self.btn_quit_no.draw(self.screen, fn)

    def _exit_event(self, event):
        if self.btn_quit_yes.is_clicked(event):
            return {"action": "quit"}
        if self.btn_quit_no.is_clicked(event):
            return {"action": "cancel_exit"}
        return None

    # ─────────────────────────────────────────────────────────────────
    # REVIEW
    # ─────────────────────────────────────────────────────────────────

    def _draw_review(self):
        W, H = self.W, self.H
        self.screen.fill(DARK_BG)
        fn = self.fonts['normal']
        fs = self.fonts['small']
        fb = self.fonts['big']

        bob = math.sin(self.float_t) * 6
        self._draw_robot(W//2, int(H * 0.26 + bob), scale=1.1, expression="happy")

        title = fb.render("遊戲結束！", True, YELLOW)
        self.screen.blit(title, title.get_rect(centerx=W//2, y=int(H*0.48)))

        if self.wrong_words:
            sub = fn.render(f"你答錯了 {len(self.wrong_words)} 個單字，要特別練習嗎？", True, WHITE)
            self.screen.blit(sub, sub.get_rect(centerx=W//2, y=int(H*0.55)))
            # list wrong words (up to 5)
            shown = self.wrong_words[:5]
            for i, w in enumerate(shown):
                ws = fs.render(f"✗  {w['en']}  ({w['zh']})", True, RED)
                self.screen.blit(ws, ws.get_rect(centerx=W//2,
                                 y=int(H*0.62) + i * 28))
            if len(self.wrong_words) > 5:
                more = fs.render(f"...還有 {len(self.wrong_words)-5} 個", True, TEXT_GRAY)
                self.screen.blit(more, more.get_rect(centerx=W//2,
                                 y=int(H0.62) + 528))
            self.btn_review_yes.draw(self.screen, fn)
        else:
            sub = fn.render("完美！沒有答錯任何題目！太厲害了！🎉", True, GREEN)
            self.screen.blit(sub, sub.get_rect(centerx=W//2, y=int(H*0.55)))

        self.btn_review_no.draw(self.screen, fn)

    def _review_event(self, event):
        if self.wrong_words and self.btn_review_yes.is_clicked(event):
            return {"action": "review_wrong"}
        if self.btn_review_no.is_clicked(event):
            return {"action": "goto_menu"}
        return None 
