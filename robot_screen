btn_y = sep_y + 34
    for i, (q, _) in enumerate(self.QUICK_OPTIONS):
        bx   = panel.x + 10 + (i % 2) * 165
        by_  = btn_y + (i // 2) * 56
        brect= pygame.Rect(bx, by_, 150, 44)
        mx, my2 = pygame.mouse.get_pos()
        hov  = brect.collidepoint(mx, my2)
        draw_rounded_rect(self.screen, BTN_HOVER if hov else BTN_GRAY, brect, 8)
        qs   = fs.render(q, True, WHITE)
        self.screen.blit(qs, qs.get_rect(center=brect.center))

def _hub_event(self, event):
    fn = self.fonts['normal']
    if self.btn_hub_start.is_clicked(event):
        return {"action": "goto_menu"}
    if self.btn_chat.is_clicked(event):
            self.chat_panel_open = not self.chat_panel_open
    if self.chat_panel_open:
        if self.btn_close_chat.is_clicked(event):
            self.chat_panel_open = False
        # quick reply click
            if event.type == pygame.MOUSEBUTTONDOWN:
                W, H = self.W, self.H
                pw   = 360
                panel= pygame.Rect(W - pw - 10, 10, pw, H - 20)
                sep_y= panel.bottom - 170
                btn_y= sep_y + 34
                for i, (q, ans) in enumerate(self.QUICK_OPTIONS):
                    bx  = panel.x + 10 + (i % 2) * 165
                    by_ = btn_y + (i // 2) * 56
                    if pygame.Rect(bx, by_, 150, 44).collidepoint(event.pos):
                        self.chat_msgs.append(ChatMessage(q, is_bot=False))
                        self.chat_msgs.append(ChatMessage(ans, is_bot=True))
        return None

    # ─────────────────────────────────────────────────────────────────
